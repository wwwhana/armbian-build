# Allwinner H616 TVBox H20 Pro 5G with 1GB of RAM
BOARD_NAME="H20 Pro 5G"
BOARDFAMILY="sun50iw9"
BOARD_MAINTAINER="Armbian Contributors"
BOOTCONFIG="h20_pro_5g_defconfig"
BOOT_LOGO="desktop"
KERNEL_TARGET="current,edge"
KERNEL_TEST_TARGET="current"
FORCE_BOOTSCRIPT_UPDATE="yes"
BOOTFS_TYPE="fat"
BOOT_FDT_FILE="sun50i-h616-h20-pro-5g.dtb"
OVERLAY_PREFIX="sun50i-h616"

enable_extension "radxa-aic8800"

# TOC0 signing requires root_key.pem in the U-Boot source directory.
# Generate a private key for this build and remove it after the binaries are built.
function pre_config_uboot_target__h20_generate_toc0_key() {
	[[ "${BOARD}" == "h20-pro-5g" ]] || return 0

	command -v openssl >/dev/null || exit_with_error "OpenSSL is required to generate the H20 TOC0 signing key"
	if [[ -e root_key.pem ]]; then
		rm -f root_key.pem
	fi
	umask 077
	openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out root_key.pem
	chmod 600 root_key.pem
}

function post_uboot_custom_postprocess__h20_remove_toc0_key() {
	[[ "${BOARD}" == "h20-pro-5g" ]] || return 0
	rm -f root_key.pem
}
