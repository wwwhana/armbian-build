+			dma-names = "tx\0rx";
+			resets = <0x02 0x15>;
+			status = "disabled";
+		};
+
+		serial@5001400 {
+			compatible = "snps,dw-apb-uart";
+			reg = <0x5001400 0x400>;
+			interrupts = <0x00 0x05 0x04>;
+			reg-shift = <0x02>;
+			reg-io-width = <0x04>;
